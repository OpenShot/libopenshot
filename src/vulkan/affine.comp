#version 450
layout(local_size_x=16, local_size_y=16) in;
layout(binding=0) uniform sampler2D plane_y;
layout(binding=1) uniform sampler2D plane_u;
layout(binding=2) uniform sampler2D plane_v;
layout(binding=3) uniform sampler2D background_tex;
layout(binding=4, rgba8) uniform writeonly image2D output_img;
// Effect parameters and tables (float bits), or scope counters.
layout(std430,binding=5) buffer Data { uint data[]; };
layout(binding=6) uniform sampler2D mask_tex;
shared uint scope_histograms[1024];
layout(push_constant) uniform Parameters {
    vec4 matrix_x;
    vec4 matrix_y;
    vec4 color_coeffs; // Y multiplier, V->R, U->G, V->G
    vec4 extra; // U->B, Y offset, chroma offset, opacity
    vec4 clear;
    ivec4 sizes; // output width/height, source width/height
    ivec4 modes; // x: source format (bits 0-3: 0 planar, 1 NV12/P01x, 2 premult RGBA, 3 straight RGBA)
                 //    plus transfer (bits 4-7) and BT.2020 gamut (bit 8), see to_sdr(); y: background enabled
    vec4 effect; // saturation controls, or crop bounds in output pixels
} p;
// Mitchell/Netravali family B=0, C=0.6 matches libswscale's default
// SWS_BICUBIC kernel. Expand the footprint on minification to suppress aliasing.
float cubic(float value) {
    float x=abs(value);
    if(x<1.0) return ((1.4*x-2.4)*x)*x+1.0;
    if(x<2.0) return ((-0.6*x+3.0)*x-4.8)*x+2.4;
    return 0.0;
}
vec4 sample_source(sampler2D image, vec2 uv) {
    if(p.modes.w==2 || p.modes.w==4 || p.modes.w==5) return texelFetch(image,ivec2(floor(uv*vec2(textureSize(image,0)))),0);
    if(p.modes.z==0) return texture(image,uv);
    ivec2 size=textureSize(image,0);
    vec2 pos=uv*vec2(size)-0.5;
    vec2 footprint=max(vec2(1.0),vec2(length(p.matrix_x.xy),length(p.matrix_y.xy))
        *vec2(size)/vec2(p.sizes.zw));
    ivec2 first=ivec2(ceil(pos-2.0*footprint));
    ivec2 last=ivec2(floor(pos+2.0*footprint));
    vec4 result=vec4(0);
    float total=0.0;
    for(int y=first.y;y<=last.y;++y) {
        float wy=cubic((float(y)-pos.y)/footprint.y);
        if(abs(wy)<0.000001) continue;
        for(int x=first.x;x<=last.x;++x) {
            float weight=wy*cubic((float(x)-pos.x)/footprint.x);
            if(abs(weight)<0.000001) continue;
            result+=texelFetch(image,clamp(ivec2(x,y),ivec2(0),size-1),0)*weight;
            total+=weight;
        }
    }
    return result/total;
}
float value(int index) { return uintBitsToFloat(data[index]); }
vec3 wheel_bias(int wheel) {
    int start=9+wheel*3;
    return vec3(value(start),value(start+1),value(start+2));
}
float grade_curve(int curve,float value) {
    int index=clamp(int(value*255.0+0.5),0,255);
    return uintBitsToFloat(data[21+curve*256+index]);
}
// HDR/wide gamut to SDR BT.709; mirrors color::SdrConverter (ColorManagement.cpp).
// Linear values are relative to the BT.2408 reference white (203 nits).
#define TONE_KNEE 0.8
#define REFERENCE_WHITE 203.0
const mat3 BT2020_TO_709=mat3( // column-major
    1.6604910,-0.1245505,-0.0181508,
   -0.5876411, 1.1328999,-0.1005789,
   -0.0728499,-0.0083494, 1.1187297);
vec3 pq_to_linear(vec3 e) {
    const float m1=2610.0/16384.0,m2=2523.0/4096.0*128.0;
    const float c1=3424.0/4096.0,c2=2413.0/4096.0*32.0,c3=2392.0/4096.0*32.0;
    vec3 v=pow(clamp(e,0.0,1.0),vec3(1.0/m2));
    return 10000.0/REFERENCE_WHITE*pow(max(v-c1,0.0)/(c2-c3*v),vec3(1.0/m1));
}
vec3 hlg_to_scene(vec3 e) {
    const float a=0.17883277,b=0.28466892,c=0.55991073;
    e=clamp(e,0.0,1.0);
    return mix(e*e/3.0,(exp((e-c)/a)+b)/12.0,greaterThan(e,vec3(0.5)));
}
float tone_map(float value,float peak) {
    if(value<=TONE_KNEE || peak<=1.0) return min(value,1.0);
    float span=1.0-TONE_KNEE,t=(value-TONE_KNEE)/span;
    float w=max((peak-TONE_KNEE)/span,1.0);
    return min(TONE_KNEE+span*t*(1.0+t/(w*w))/(1.0+t),1.0);
}
vec3 to_sdr(vec3 signal) {
    int transfer=(p.modes.x>>4)&15;
    bool bt2020=(p.modes.x&256)!=0;
    vec3 rgb;
    if(transfer==1) rgb=pq_to_linear(signal);
    else if(transfer==2) {
        // HLG OOTF for the nominal 1000 nit display (system gamma 1.2).
        vec3 scene=hlg_to_scene(signal);
        float luma=dot(scene,bt2020?vec3(0.2627,0.6780,0.0593):vec3(0.2126,0.7152,0.0722));
        rgb=scene*(1000.0/REFERENCE_WHITE)*pow(clamp(luma,0.0,1.0),0.2);
    } else rgb=pow(clamp(signal,0.0,1.0),vec3(2.4));
    if(bt2020) rgb=BT2020_TO_709*rgb;
    rgb=max(rgb,0.0);
    float brightest=max(rgb.r,max(rgb.g,rgb.b));
    if(brightest>TONE_KNEE) rgb*=tone_map(brightest,p.matrix_y.w)/brightest;
    return pow(min(rgb,1.0),vec3(1.0/2.4));
}
// Premultiplied RGBA from any supported source format.
vec4 load_source(vec2 uv) {
    if((p.modes.x&15)>=2) {
        vec4 front=clamp(sample_source(plane_y,uv),0.0,1.0);
        if((p.modes.x&15)==3) front.rgb*=front.a;
        else front.rgb=min(front.rgb,vec3(front.a));
        return front;
    }
    float y=(sample_source(plane_y,uv).r-p.extra.y)*p.color_coeffs.x;
    vec2 chroma=(p.modes.x&15)==1 ? sample_source(plane_u,uv).rg : vec2(sample_source(plane_u,uv).r,sample_source(plane_v,uv).r);
    chroma-=p.extra.z;
    vec3 rgb=clamp(vec3(y+p.color_coeffs.y*chroma.y,
        y+p.color_coeffs.z*chroma.x+p.color_coeffs.w*chroma.y,
        y+p.extra.x*chroma.x),0,1);
    if((p.modes.x>>4)!=0) rgb=to_sdr(rgb);
    return vec4(rgb,1);
}
// ColorMap table: domain min/max, then RGB entries.
vec3 lut_entry(int index) { int i=6+index*3; return vec3(value(i),value(i+1),value(i+2)); }
float lut_1d(float v,int channel,int size) {
    if(size<=1) return value(6+channel);
    precise float scaled=v*float(size-1);
    int i0=int(floor(scaled)),i1=min(i0+1,size-1);
    precise float t=scaled-float(i0);
    int last=size*3-1;
    return value(6+clamp(i0*3+channel,0,last))*(1.0-t)+value(6+clamp(i1*3+channel,0,last))*t;
}
vec3 lut_3d(vec3 v,int n) {
    precise vec3 f=v*float(n-1);
    ivec3 i0=ivec3(floor(f)),i1=min(i0+1,ivec3(n-1));
    precise vec3 d=f-vec3(i0);
    #define LUT(r,g,b) lut_entry(((b*n+g)*n+r))
    precise vec3 c00=LUT(i0.r,i0.g,i0.b)*(1.0-d.r)+LUT(i1.r,i0.g,i0.b)*d.r;
    precise vec3 c01=LUT(i0.r,i0.g,i1.b)*(1.0-d.r)+LUT(i1.r,i0.g,i1.b)*d.r;
    precise vec3 c10=LUT(i0.r,i1.g,i0.b)*(1.0-d.r)+LUT(i1.r,i1.g,i0.b)*d.r;
    precise vec3 c11=LUT(i0.r,i1.g,i1.b)*(1.0-d.r)+LUT(i1.r,i1.g,i1.b)*d.r;
    #undef LUT
    precise vec3 c0=c00*(1.0-d.g)+c10*d.g;
    precise vec3 c1=c01*(1.0-d.g)+c11*d.g;
    return c0*(1.0-d.b)+c1*d.b;
}
// FrameScope analysis: shared histograms per workgroup, global waveforms and
// vectorscope. Matches FrameScope::analyze_video's byte math.
void scope() {
    for(uint i=gl_LocalInvocationIndex;i<1024u;i+=256u) scope_histograms[i]=0u;
    barrier();
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);
    ivec4 region=ivec4(p.effect);
    if(all(greaterThanEqual(pixel,region.xy)) && all(lessThan(pixel,region.zw))) {
        ivec4 c=ivec4(round(load_source((vec2(pixel)+0.5)/vec2(p.sizes.zw))*255.0));
        if(c.a>0) {
            const float inv255=1.0/255.0;
            precise vec3 f;
            ivec3 index;
            if(c.a==255) { f=vec3(c.rgb)*inv255; index=c.rgb; }
            else {
                f=min(vec3(1.0),(vec3(c.rgb)*(255.0/float(c.a)))*inv255);
                index=ivec3(f*255.0+0.5);
            }
            precise float luma=0.299*f.r+0.587*f.g+0.114*f.b;
            int luma_index=int(luma*255.0+0.5);
            int columns=int(p.clear.x),bins=int(p.clear.y),size=int(p.clear.z);
            int column=clamp(((pixel.x-region.x)*columns)/max(1,int(p.clear.w)),0,columns-1);
            uint plane=uint(columns*bins),wave=1024u+uint(column*bins);
            precise float u=-0.14713*f.r-0.28886*f.g+0.43600*f.b;
            precise float v=0.61500*f.r-0.51499*f.g-0.10001*f.b;
            float middle=float(size-1)*0.5;
            int vx=clamp(int(middle+(u/0.43600)*middle+0.5),0,size-1);
            int vy=clamp(int(middle-(v/0.61500)*middle+0.5),0,size-1);
            atomicAdd(scope_histograms[luma_index],1u);
            atomicAdd(scope_histograms[256+index.r],1u);
            atomicAdd(scope_histograms[512+index.g],1u);
            atomicAdd(scope_histograms[768+index.b],1u);
            atomicAdd(data[wave+uint(luma_index)],1u);
            atomicAdd(data[wave+plane+uint(index.r)],1u);
            atomicAdd(data[wave+2u*plane+uint(index.g)],1u);
            atomicAdd(data[wave+3u*plane+uint(index.b)],1u);
            atomicAdd(data[1024u+4u*plane+uint(vy*size+vx)],1u);
        }
    }
    barrier();
    for(uint i=gl_LocalInvocationIndex;i<1024u;i+=256u)
        if(scope_histograms[i]!=0u) atomicAdd(data[i],scope_histograms[i]);
}
void main() {
    // Scopes count instead of writing an image; every invocation reaches the barriers.
    if(p.modes.w==8) { scope(); return; }
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(pixel,p.sizes.xy))) return;
    vec2 center=vec2(pixel)+0.5;
    vec2 src=vec2(dot(p.matrix_x.xyz,vec3(center,1)),dot(p.matrix_y.xyz,vec3(center,1)));
    vec4 front=vec4(0);
    if(all(greaterThanEqual(src,vec2(0))) && all(lessThan(src,vec2(p.sizes.zw)))) {
        front=load_source(src/vec2(p.sizes.zw));
        if(p.modes.w==1 && front.a>0.0) {
            // Match Saturation's integer rounding and fixed-point brightness.
            int alpha=int(round(front.a*255.0));
            ivec3 rgb=ivec3(round(front.rgb*255.0));
            if(alpha<255) rgb=ivec3(vec3(rgb)*(255.0/float(alpha)));
            int weighted=(77*rgb.r*rgb.r+150*rgb.g*rgb.g+29*rgb.b*rgb.b+128)>>8;
            float brightness=sqrt(float(weighted));
            rgb=clamp(ivec3(vec3(brightness)+(vec3(rgb)-brightness)*p.effect.x),ivec3(0),ivec3(255));
            vec3 channel=vec3(rgb)*sqrt(vec3(0.299,0.587,0.114));
            ivec3 red=ivec3(vec3(channel.r)+(vec3(rgb.r,0,0)-channel.r)*p.effect.y);
            ivec3 green=ivec3(vec3(channel.g)+(vec3(0,rgb.g,0)-channel.g)*p.effect.z);
            ivec3 blue=ivec3(vec3(channel.b)+(vec3(0,0,rgb.b)-channel.b)*p.effect.w);
            rgb=clamp(red+green+blue,ivec3(0),ivec3(255));
            if(alpha<255) rgb=ivec3(vec3(rgb)*(float(alpha)/255.0));
            front.rgb=vec3(rgb)/255.0;
        }
        if(p.modes.w==3 && front.a>0.0) {
            vec3 original=front.rgb/front.a;
            vec3 rgb=original;
            rgb.r=clamp(rgb.r+p.effect.x*0.125,0.0,1.0);
            rgb.b=clamp(rgb.b-p.effect.x*0.125,0.0,1.0);
            rgb=clamp(rgb+vec3(0.05,-0.1,0.05)*p.effect.y,0.0,1.0);
            rgb=clamp(rgb*p.effect.z,0.0,1.0);
            rgb=clamp((rgb-0.5)*p.effect.w+0.5,0.0,1.0);
            float luma=dot(rgb,vec3(0.299,0.587,0.114));
            rgb=clamp(rgb+0.35*(p.clear.x*(1.0-luma)*(1.0-luma)+p.clear.y*luma*luma),0.0,1.0);
            luma=dot(rgb,vec3(0.299,0.587,0.114));
            float centered=abs(luma-0.5)*2.0;
            rgb=clamp(rgb+wheel_bias(0)+wheel_bias(1)*(1.0-luma)*(1.0-luma)
                +wheel_bias(2)*clamp(1.0-centered*centered,0.0,1.0)+wheel_bias(3)*luma*luma,0.0,1.0);
            luma=dot(rgb,vec3(0.299,0.587,0.114));
            float colorfulness=max(rgb.r,max(rgb.g,rgb.b))-min(rgb.r,min(rgb.g,rgb.b));
            float factor=p.clear.z*max(0.0,1.0+p.clear.w*(1.0-colorfulness));
            rgb=clamp(luma+(rgb-luma)*factor,0.0,1.0);
            rgb=vec3(grade_curve(0,rgb.r),grade_curve(0,rgb.g),grade_curve(0,rgb.b));
            rgb=vec3(grade_curve(1,rgb.r),grade_curve(2,rgb.g),grade_curve(3,rgb.b));
            rgb=clamp(mix(original,rgb,p.matrix_x.w),0.0,1.0);
            front.rgb=floor(rgb*front.a*255.0+0.5)/255.0;
        }
        if(p.modes.w==6 && front.a>0.0) {
            // ColorMap: straight color from premultiplied bytes, truncating writes.
            ivec4 bytes=ivec4(round(front*255.0));
            float alpha=float(bytes.a)/255.0;
            precise vec3 color=(vec3(bytes.rgb)/alpha)*(1.0/255.0);
            vec3 low=vec3(value(0),value(1),value(2)),range=vec3(value(3),value(4),value(5))-low;
            vec3 domain;
            for(int i=0;i<3;++i) domain[i]=clamp(range[i]<=0.0?color[i]:(color[i]-low[i])/range[i],0.0,1.0);
            int size=int(p.effect.x);
            vec3 mapped=p.effect.y!=0.0?lut_3d(domain,size):
                vec3(lut_1d(domain.r,0,size),lut_1d(domain.g,1,size),lut_1d(domain.b,2,size));
            vec3 amount=vec3(p.effect.zw,p.clear.x);
            precise vec3 blended=(mapped*amount+color*(1.0-amount))*alpha;
            front.rgb=vec3(clamp(ivec3(blended*255.0),ivec3(0),ivec3(255)))/255.0;
        }
        front*=p.extra.w;
    }
    if(p.modes.w==2 && (any(lessThan(center,p.effect.xy)) || any(greaterThanEqual(center,p.effect.zw))))
        front=vec4(0);
    vec4 back=p.modes.y==1 ? texture(background_tex,center/vec2(p.sizes.xy)) : p.clear;
    if(p.modes.w==5) {
        ivec2 first=ivec2(p.effect.zw),last=ivec2(p.clear.xy);
        if(all(greaterThanEqual(pixel,first)) && all(lessThanEqual(pixel,last))) {
            int radius=int(p.effect.x);
            ivec2 direction=p.effect.y==0.0?ivec2(1,0):ivec2(0,1);
            ivec4 total=ivec4(0);
            for(int offset=-radius;offset<=radius;++offset)
                total+=ivec4(round(texelFetch(plane_y,clamp(pixel+direction*offset,first,last),0)*255.0));
            front=floor(vec4(total)/float(2*radius+1)+0.5)/255.0;
        }
    }
    if(p.modes.w==4) {
        ivec4 mask=ivec4(round(back*255.0));
        int gray=(mask.r*11+mask.g*16+mask.b*5)>>5;
        // Preserve CPU rounding before truncation: do not fuse multiply/add.
        precise float adjusted_value=p.effect.x*(float(gray)+p.effect.y-128.0)+128.0;
        int adjusted=clamp(int(adjusted_value),0,255);
        int alpha=clamp(mask.a-adjusted,0,255);
        if(p.effect.w!=0.0) front=vec4(float(alpha)/255.0);
        else {
            if(p.effect.z!=0.0) alpha=255-alpha;
            front=floor(round(front*255.0)*float(alpha)/255.0)/255.0;
        }
    }
    if(p.modes.w==7) {
        // EffectBase::BlendWithMask: mix input (background) and result by mask
        // gray. The table holds the factor, then its inverse, per gray value.
        ivec4 effected=ivec4(round(front*255.0)),original=ivec4(round(back*255.0));
        ivec4 mask=ivec4(round(texelFetch(mask_tex,pixel,0)*255.0));
        int gray=(mask.r*11+mask.g*16+mask.b*5)/32;
        precise vec4 mixed=vec4(original)*value(256+gray)+vec4(effected)*value(gray);
        front=floor(mixed)/255.0;
        // Drive-amount masks keep the input's alpha.
        if(p.effect.x!=0.0) front.a=float(original.a)/255.0;
    }
    if(p.modes.w>=3) back=vec4(0);
    imageStore(output_img,pixel,front+back*(1-front.a));
}
